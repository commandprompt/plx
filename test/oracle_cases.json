{
 "cases": [
  {
   "dialect": "plxlua",
   "id": "int-floor-div",
   "params": [
    {
     "name": "a",
     "sql": "int",
     "cs": "int",
     "value": -7
    },
    {
     "name": "b",
     "sql": "int",
     "cs": "int",
     "value": 2
    }
   ],
   "returns": {
    "sql": "text",
    "cs": "string"
   },
   "body": "return tostring(a // b) .. \" \" .. tostring(a % b)",
   "expected": "-4 1",
   "diverges": "% truncates toward zero as in SQL (plxlua.md, Semantic differences)",
   "plx": "-4 -1"
  },
  {
