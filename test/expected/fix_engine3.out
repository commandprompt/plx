-- an escaped backslash before the interpolation does not escape it: still a read
CREATE FUNCTION e3_v1_php_bs(n int) RETURNS text LANGUAGE plxphp AS $body$
for ($i = 0; $i < $n; $i++) { }
return "bs \\$i";
$body$;
