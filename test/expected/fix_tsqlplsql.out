ERROR:  neg1
CREATE FUNCTION fx46_log() RETURNS int LANGUAGE plxtsql AS $$
  RAISERROR('logged', 0, 1) WITH LOG, SETERROR;
  RETURN 1;
$$;
SELECT position('RAISE LOG' in prosrc) > 0 AS has_log FROM pg_proc WHERE proname = 'fx46_log';
 has_log 
---------
