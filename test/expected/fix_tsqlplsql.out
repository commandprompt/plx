  DECLARE @s varchar(10);
  SELECT @s = CASE WHEN v > 2 THEN 'big' ELSE 'small' END FROM fx43_amt WHERE v = 3;
  RETURN @s;
$$;
SELECT fx47_sel();
 fx47_sel 
