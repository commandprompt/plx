(1 row)

CREATE FUNCTION fxco_n() RETURNS text LANGUAGE plxtsql AS $$
  RETURN COALESCE(N'1', 2) + N'3';
$$;
SELECT fxco_n() AS r;  -- SQL Server: 4
 r 
---
