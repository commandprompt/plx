let r = fetch_one(`SELECT E'a\\${x}' AS v, ${literal(y)} AS w`);
return r.v;
$f$;
ERROR:  plxjs: an interpolation cannot follow an unpaired backslash in an E'...' SQL string; write a literal backslash as two backslashes
DETAIL:  at plxjs source line 2
