----------+--------------
 a4_drng  |          100
 a4_rng   |          100
(2 rows)

SELECT a4_rng('a', 'c') @> 'b'::plx_strbuild AS rng_has,
       a4_drng('a', 'c') @> 'b'::a4_rdom AS drng_has;
