-- A7: ^ is bitwise XOR in Ruby, PHP, JS, TS and Python, not SQL exponent
CREATE FUNCTION fe_a7_xor_rb(a int, b int) RETURNS int LANGUAGE plxruby AS $$
return a ^ b
$$;
SELECT fe_a7_xor_rb(6, 3);
 fe_a7_xor_rb 
--------------
            5
(1 row)

