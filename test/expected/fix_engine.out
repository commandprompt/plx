---------------+--------+--------
 fe_a2_jsub_js | t      | f
 fe_a2_jsub_py | f      | t
(2 rows)

-- A2: a composite parameter and a query row still take field subscripts
CREATE TYPE fe_a2_pt AS (name text, "a b" int);
CREATE FUNCTION fe_a2_comp_js(r fe_a2_pt) RETURNS text LANGUAGE plxjs AS $$
return r['name'];
