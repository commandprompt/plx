SELECT proname, prosrc LIKE '%RETURN j[''a''];%' AS j_kept,
       prosrc LIKE '%RETURN d[''a''];%' AS d_kept
FROM pg_proc WHERE proname IN ('fe_a2_jsub_js', 'fe_a2_jsub_py') ORDER BY proname;
