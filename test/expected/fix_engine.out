$r = fetch_one("SELECT 'bob'::text AS name");
$a = ARRAY['x', 'y'] /*:: text[] */;
return "Hello $r->name! $r[name] $a[1] $a[$i] $r->name->x $r-> $a[";
$$;
SELECT fe_a10_php(2);
