-- A2: a variable named array is not the ARRAY constructor. array is an SQL
-- reserved word, so plpgsql cannot compile the generated "array.name" and
-- CREATE FUNCTION rejects it (see LIMITATIONS.md). Turn the compile check off
-- to store the functions and inspect what plx generated.
SET check_function_bodies = off;
CREATE FUNCTION fe_a2_var_php() RETURNS text LANGUAGE plxphp AS $$
$array = fetch_one("SELECT 'bob'::text AS name");
return $array['name'];
$$;
CREATE FUNCTION fe_a2_var_rb() RETURNS text LANGUAGE plxruby AS $$
array = fetch_one("SELECT 'bob'::text AS name")
return array['name']
$$;
RESET check_function_bodies;
SELECT proname, prosrc LIKE '%RETURN array.name;%' AS field_read
FROM pg_proc WHERE proname IN ('fe_a2_var_php', 'fe_a2_var_rb') ORDER BY proname;
    proname    | field_read 
---------------+------------
 fe_a2_var_php | t
 fe_a2_var_rb  | t
(2 rows)

