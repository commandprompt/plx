CREATE FUNCTION fg33_bases() RETURNS bigint LANGUAGE plxgo AS $$
 x := 0XE
 return int64(x) + 0x1F + 0b101 + 1_000 + 0xFF_FF
$$;
SELECT fg33_bases() AS go_66585;
 go_66585 
----------
    66585
