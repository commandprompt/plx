-- a hexadecimal literal with an E digit is an integer, so / divides as integers
CREATE FUNCTION fg33_hexe() RETURNS text LANGUAGE plxgo AS $$
 x := 0XE
 return x / 4
$$;
SELECT fg33_hexe() AS go_3;
 go_3 
------
 3
(1 row)

