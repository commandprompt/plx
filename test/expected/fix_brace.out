-- A16: PHP break N and continue N leave or continue the N-th enclosing loop or switch
CREATE FUNCTION fb_bn1(n int) RETURNS int LANGUAGE plxphp AS $$
$c = 0;
for ($i = 0; $i < $n; $i++) {
  for ($j = 0; $j < $n; $j++) {
    $c = $c + 1;
    if ($j == 1) { break 2; }
  }
}
return $c;
$$;
SELECT fb_bn1(5);
 fb_bn1 
