CREATE FUNCTION fb_bn2(n int) RETURNS int LANGUAGE plxphp AS $$
$c = 0;
for ($i = 0; $i < $n; $i++) {
  switch ($i % 2) {
    case 0:
      continue 2;
    default:
      $c = $c + 1;
      break;
  }
  $c = $c + 10;
}
return $c;
$$;
