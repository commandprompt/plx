CREATE FUNCTION fb_sw7(n int) RETURNS int LANGUAGE plxjs AS $$
let c = 0;
for (let i = 0; i < n; i++) {
  switch (i) {
    case 2:
      continue;
    default:
      c = c + 1;
      break;
  }
  c = c + 10;
}
return c;
$$;
