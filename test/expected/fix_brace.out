return $i;
$$;
ERROR:  plxphp: the loop variable "i" is read after the for loop, but a counting for does not keep its final value; use a while loop
CREATE FUNCTION fb_f8(n int) RETURNS int LANGUAGE plxjs AS $$
let c = 0;
for (let i = 0; i < n; j++) { c = c + 1; }
return c;
