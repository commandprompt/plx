-- N-swlabel: a switch arm may end with a labelled break or with continue
CREATE FUNCTION fb_sw6(n int) RETURNS int LANGUAGE plxjs AS $$
let c = 0;
outer: for (let i = 0; i < n; i++) {
  switch (i) {
    case 2:
      break outer;
    default:
      c = c + 1;
      break;
  }
}
return c;
$$;
