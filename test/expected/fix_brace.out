-- A17: a for that is not a plain counting loop is rejected, not lowered to a wrong FOR
\set VERBOSITY terse
CREATE FUNCTION fb_f1(n int) RETURNS int LANGUAGE plxjs AS $$
let c = 0;
for (let i = 0; c < n; i++) { c = c + 2; }
return c;
$$;
ERROR:  plxjs: for-loop condition must test the loop variable "i"; use a while loop for other conditions
CREATE FUNCTION fb_f2(n int) RETURNS int LANGUAGE plxjs AS $$
let c = 0; let lim = n;
for (let i = 0; i < lim; i++) { lim = 2; c = c + 1; }
return c;
$$;
ERROR:  plxjs: the for-loop body assigns "lim", which the loop bound or step uses; a counting for evaluates them once, so use a while loop
CREATE FUNCTION fb_f3() RETURNS int LANGUAGE plxjs AS $$
let i = 0; let c = 0;
for (i = 0; i < 10; i++) { i = i + 1; c = c + 1; }
return c;
$$;
ERROR:  plxjs: the for-loop body assigns the loop variable "i"; use a while loop
CREATE FUNCTION fb_f4(n int) RETURNS int LANGUAGE plxjs AS $$
let i = 0;
for (i = 0; i < n; i++) { }
return i;
$$;
ERROR:  plxjs: the loop variable "i" is read after the for loop, but a counting for does not keep its final value; use a while loop
CREATE FUNCTION fb_f5(n int) RETURNS int LANGUAGE plxjs AS $$
